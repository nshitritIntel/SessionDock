{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/main/nicegui/static/tauri-conf-schema.json",
  "productName": "SessionDock",
  "version": "2.0.1",
  "identifier": "com.sessiondock.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SessionDock",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:1421; font-src 'self' data:; form-action 'none'; frame-src 'none'; img-src 'self' asset: http://asset.localhost data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../THIRD_PARTY_NOTICES.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/nshitritIntel/SessionDock/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOUUzNDdCM0FDMUE1NjkKUldScHBjRTZlelNleTVBdVV3ZXQ4OXNTdnZNSVp5RFlaYnhHemdPazlTUG1CbFFIZHFJM2hSWksK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
